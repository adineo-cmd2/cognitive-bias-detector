---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Settings — Bias Mirror" description="Account, documents, export, and deletion for the local Bias Mirror reader.">
  <h1 class="page-title">Settings</h1>
  <div class="page-lede">
    <p class="lead">
      The local record: one reader, the documents you have submitted, and the keys to take them out again.
    </p>
    <p class="page-ref">Form 06 · record · local only</p>
  </div>

  <section class="sheet" style="margin-top: 2rem">
    <div class="sheet-head">
      <span>Account</span>
      <span>single local reader</span>
    </div>
    <h2 class="sheet-title">One reader, no login.</h2>
    <p class="text-sm text-soft">This copy runs for a single local user. There is no account to create.</p>
    <p class="mt-2 text-sm text-soft">Backend: <span id="api-base" class="mono-n"></span></p>
  </section>

  <section class="sheet">
    <div class="sheet-head">
      <span>Documents</span>
      <span>source text and flags</span>
    </div>
    <h2 class="sheet-title">Stored documents</h2>
    <p id="docs-msg" class="mb-2 text-sm text-soft"></p>
    <ul id="docs-list" class="flex max-w-2xl flex-col gap-2"></ul>
    <div class="mt-4 flex flex-wrap gap-2">
      <button id="export-btn" class="btn btn-ghost">
        Export bias map (JSON)
      </button>
      <button id="delete-all-btn" class="btn btn-accent">
        Delete all my data
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import { BASE, apiDelete, apiGet } from '../lib/apiClient';

  interface DocRow {
    id: number;
    filename: string;
    chunks: number;
    biases: number;
    created_at: string | null;
  }

  async function loadDocs() {
    const list = document.getElementById('docs-list') as HTMLUListElement;
    const msg = document.getElementById('docs-msg') as HTMLParagraphElement;
    list.innerHTML = '';
    try {
      // GET /api/documents (no trailing slash) returns a bare array.
      const data: unknown = await apiGet('/api/documents');
      const docs = Array.isArray(data) ? (data as DocRow[]) : [];
      if (docs.length === 0) {
        msg.textContent = 'No documents yet.';
        return;
      }
      msg.textContent = `${docs.length} document(s).`;
      for (const d of docs) {
        const li = document.createElement('li');
        li.className = 'docs-row';
        const span = document.createElement('span');
        span.textContent = `${d.filename} — ${d.chunks} chunks, ${d.biases} flags`;
        const btn = document.createElement('button');
        btn.textContent = 'Delete';
        btn.className = 'docs-delete';
        btn.addEventListener('click', () => void deleteDoc(d.id));
        li.append(span, btn);
        list.append(li);
      }
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Failed to load documents.';
    }
  }

  async function deleteDoc(id: number) {
    const msg = document.getElementById('docs-msg') as HTMLParagraphElement;
    try {
      await apiDelete(`/api/documents/${id}`);
      await loadDocs();
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Delete failed.';
    }
  }

  document.getElementById('export-btn')?.addEventListener('click', async () => {
    const msg = document.getElementById('docs-msg') as HTMLParagraphElement;
    try {
      const data = await apiGet('/api/profile/bias-map');
      const blob = new Blob([JSON.stringify(data, null, 2)], {
        type: 'application/json',
      });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'bias-map.json';
      a.click();
      URL.revokeObjectURL(url);
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Export failed.';
    }
  });
  document.getElementById('delete-all-btn')?.addEventListener('click', async () => {
    const msg = document.getElementById('docs-msg') as HTMLParagraphElement;
    if (!window.confirm('Delete ALL your documents and bias data? This cannot be undone.')) return;
    try {
      await apiDelete('/api/documents');
      await loadDocs();
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Delete-all failed.';
    }
  });
  const base = document.getElementById('api-base');
  if (base) base.textContent = BASE;
  void loadDocs();
</script>
