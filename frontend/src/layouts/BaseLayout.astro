---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bias Mirror — your writing, turned into a mirror',
  description = 'Read your own drafts for cognitive patterns. Every flag keeps the sentence that triggered it.',
} = Astro.props;

const site = Astro.site ?? new URL('https://adineo-cmd2.github.io');
const canonical = new URL(Astro.url.pathname, site);
const fullTitle = title.includes('Bias Mirror') ? title : `${title} · Bias Mirror`;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const route = base && current.startsWith(base) ? current.slice(base.length) || '/' : current;
const folios: Record<string, string> = {
  '/': '01',
  '/upload': '02',
  '/bias-map': '03',
  '/timeline': '04',
  '/explorer': '05',
  '/settings': '06',
};
const folio = folios[route] ?? '00';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%20100%20100%27%3E%3Crect%20width%3D%27100%27%20height%3D%27100%27%20fill%3D%27%23f6f0e3%27%2F%3E%3Ctext%20x%3D%2750%27%20y%3D%2768%27%20font-family%3D%27Georgia%2Cserif%27%20font-size%3D%2764%27%20fill%3D%27%239c2f24%27%20text-anchor%3D%27middle%27%3EB%3C%2Ftext%3E%3C%2Fsvg%3E" />
    <meta name="theme-color" content="#f6f0e3" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bias Mirror" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Karla:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class="page-wrap">
      <div class="page-margin" aria-hidden="true">
        <span class="folio-label">folio</span>
        <span class="folio-number">{folio}</span>
      </div>
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll-reveal: fade sections in as they enter the viewport.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
