---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const year = new Date().getFullYear();
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/upload", "label": "Upload"}, {"href": "/bias-map", "label": "Bias Map"}, {"href": "/timeline", "label": "Timeline"}, {"href": "/explorer", "label": "Explorer"}, {"href": "/settings", "label": "Settings"}];
---
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a href={base || '/'} class="brand" style="margin-bottom: 0.9rem">
        <span class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="9" rx="7" ry="8"/><path d="M12 17v4M9 21h6M9.5 7.5c.7-1 2-1.6 3-1.4"/></svg></span>
        <span>Bias Mirror</span>
      </a>
      <p class="text-sm leading-relaxed" style="color: var(--ink-soft); max-width: 34rem">
        Bias Mirror — flags are probabilistic suggestions, not diagnoses. Your raw text is encrypted at rest and never shared.
      </p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href === '/' ? base || '/' : `${base}${l.href}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Project</h4>
      <ul class="footer-links">
        <li><a href="https://github.com/adineo-cmd2/cognitive-bias-detector" target="_blank" rel="noreferrer">Source on GitHub ↗</a></li>
        <li><a href="https://adineo-cmd2.github.io/cognitive-bias-detector/" target="_blank" rel="noreferrer">Live site ↗</a></li>
        <li><span style="font-size: 0.88rem">Local backend · <span class="mono">localhost:8002</span></span></li>
        <li><span style="font-size: 0.88rem">FastAPI + Astro + React</span></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} Bias Mirror · Aditya Yadav</span>
      <span>Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>
